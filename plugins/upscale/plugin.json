{
  "id": "ai.photocraft.plugins.upscale",
  "name": "AI Super-Resolution (2x)",
  "version": "1.0.0",
  "description": "2x neural super-resolution upscale for PhotoCraft active layer via local ONNX Runtime & DirectML GPU.",
  "author": "kobaltGIT",
  "plugin_type": "native_ai",
  "action_id": "plugin:upscale",
  "icon": "zoom-in",
  "input": "active_layer",
  "output_mode": "in_place",
  "post_commands": [
    {
      "command": "image.revealAll"
    },
    {
      "command": "layer.mergeDown"
    }
  ],
  "ai": {
    "task": "super_resolution",
    "scale": 2
  },
  "models": [
    {
      "name": "realesrgan-x2.onnx",
      "required": true,
      "size_mb": 68,
      "url": "https://huggingface.co/yuvraj108c/ComfyUI-Upscaler-Onnx/resolve/main/2x-ESRGAN.onnx"
    }
  ]
}
