{
  "id": "ai.photocraft.plugins.inpaint",
  "name": "AI Generative Fill (LaMa)",
  "version": "1.0.0",
  "description": "Zero-prompt neural generative fill and object eraser for PhotoCraft using LaMa model via DirectML GPU.",
  "author": "kobaltGIT",
  "plugin_type": "native_ai",
  "action_id": "plugin:inpaint",
  "icon": "icon.svg",
  "input": "selection",
  "output_mode": "in_place",
  "post_commands": [
    {
      "command": "layer.mergeDown"
    }
  ],
  "ai": {
    "task": "inpainting"
  },
  "models": [
    {
      "name": "lama_inpaint.onnx",
      "required": true,
      "size_mb": 208,
      "url": "https://huggingface.co/Carve/LaMa-ONNX/resolve/main/lama_fp32.onnx"
    }
  ]
}
